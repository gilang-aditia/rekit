{
  "name": "@moonblanck/rakit-ui",
  "version": "0.0.4",
  "type": "module",
  "bin": {
    "rakit-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && npm run copy-ui",
    "copy-ui": "mkdir -p dist/ui && cp -R ../ui/registry ./dist/ui/registry && cp -R ../ui/src ./dist/ui/src",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2",
    "fs-extra": "^11.2.0",
    "execa": "^8.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/prompts": "^2.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  }
}
